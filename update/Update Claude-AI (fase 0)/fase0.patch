+
+
+def _rate_ok(key: str, limit: int = 10, window: float = 60.0) -> bool:
+    now = time.time()
+    hits = [t for t in _rate_hits.get(key, []) if now - t < window]
+    if len(hits) >= limit:
+        _rate_hits[key] = hits
+        return False
+    hits.append(now)
+    _rate_hits[key] = hits
+    return True
 
 
